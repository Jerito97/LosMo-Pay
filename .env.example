# Neon Postgres connection string.
# Create a project at https://neon.tech (or Vercel dashboard -> Storage -> Neon)
# and copy the "pooled connection" string here.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/losmopay?sslmode=require"

# Random 32+ char secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared secret required in the Authorization header of the birthday cron
# request, so only Vercel Cron (or you) can trigger it. Generate the same way.
CRON_SECRET="change-me-to-a-long-random-string"
